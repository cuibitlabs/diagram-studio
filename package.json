{
  "name": "diagram-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diagrams as code: 43 diagram types with a real layout engine, honest imports and audited accessibility. Browser studio, CLI and MCP server on one deterministic engine.",
  "license": "MIT",
  "keywords": [
    "diagram",
    "diagrams-as-code",
    "diagram-generator",
    "architecture-diagram",
    "c4-model",
    "flowchart",
    "sequence-diagram",
    "er-diagram",
    "wardley-map",
    "sankey",
    "gantt",
    "svg",
    "mermaid",
    "drawio",
    "excalidraw",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "accessibility",
    "wcag",
    "graph-layout",
    "orthogonal-routing",
    "visualization",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuibitlabs/diagram-studio.git"
  },
  "bugs": {
    "url": "https://github.com/cuibitlabs/diagram-studio/issues"
  },
  "homepage": "https://github.com/cuibitlabs/diagram-studio#readme",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "diagram-studio": "./bin/diagram-studio.mjs",
    "diagram-studio-mcp": "./bin/mcp-server.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./model": "./src/model.js",
    "./render": "./src/render/svg.js",
    "./import": "./src/importers.js",
    "./theme": "./src/theme/palettes.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "commands",
    "prompts",
    "examples"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check": "npm run test && npm run build && npm run verify",
    "verify": "python scripts/run-verifiers.py",
    "gallery": "node scripts/build-gallery.mjs",
    "examples": "node scripts/build-examples.mjs",
    "docs": "node scripts/build-type-docs.mjs && node scripts/build-examples.mjs",
    "cli": "node bin/diagram-studio.mjs",
    "mcp": "node bin/mcp-server.mjs",
    "sync:adapters": "node scripts/sync-adapters.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.1"
  }
}
